{
  "name": "Title",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The tier label shown next to a member's name"
    },
    "color": {
      "type": "string",
      "description": "The one colour that belongs to this tier, e.g. #8B5CF6"
    },
    "tier_type": {
      "type": "string",
      "enum": [
        "standard",
        "admin",
        "founder"
      ],
      "default": "standard",
      "description": "standard = a member tier that only opens channels, admin = can manage members and propose changes, founder = full control"
    }
  },
  "required": [
    "name",
    "color"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}