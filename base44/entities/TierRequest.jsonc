{
  "name": "TierRequest",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "structure",
        "promotion",
        "assignment"
      ],
      "description": "structure = add, rename or remove a tier, promotion = make someone an admin, assignment = change who holds which tiers"
    },
    "summary": {
      "type": "string",
      "description": "Plain sentence describing what the change would do"
    },
    "payload": {
      "type": "object",
      "description": "The exact change to apply once it is agreed"
    },
    "proposed_by": {
      "type": "string"
    },
    "proposed_by_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "applied",
        "rejected"
      ],
      "default": "pending"
    },
    "approvals": {
      "type": "array",
      "description": "Admins who have agreed to this change",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        }
      }
    },
    "resolved_by_name": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "summary"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}